{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phrases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "phrases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "native",
          "reading",
          "english",
          "tags",
          "difficulty"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "native": {
            "type": "string",
            "minLength": 1
          },
          "reading": {
            "type": "string",
            "minLength": 1
          },
          "english": {
            "type": "string",
            "minLength": 1
          },
          "speak": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "audioSrc": {
            "type": "string",
            "minLength": 1
          },
          "listen": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
