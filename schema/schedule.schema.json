{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plans"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "dailyMinutes",
          "weeks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "dailyMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 120
          },
          "weeks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "week",
                "focus",
                "title",
                "tasks"
              ],
              "properties": {
                "week": {
                  "type": "integer",
                  "minimum": 1
                },
                "focus": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "tasks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "minutes"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "review",
                          "kana",
                          "phrases",
                          "numbers",
                          "prices",
                          "reading",
                          "dialogue",
                          "commute"
                        ]
                      },
                      "ref": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*$"
                      },
                      "days": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 6
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      },
                      "minutes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 60
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "phraseIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9-]*$"
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
