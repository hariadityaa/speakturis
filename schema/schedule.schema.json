{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dailyMinutes",
    "weeks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dailyMinutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 120
    },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "week",
          "focus",
          "title",
          "tasks"
        ],
        "properties": {
          "week": {
            "type": "integer",
            "minimum": 1
          },
          "focus": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "minutes"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "review",
                    "kana",
                    "phrases",
                    "numbers",
                    "prices",
                    "reading",
                    "dialogue",
                    "commute"
                  ]
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "newPhraseIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
