    {
      "id": "d-hotel",
      "title": "Checking in at the hotel",
      "situation": "hotel",
      "intro": "You arrive at your Sapporo hotel with your suitcase. Your booking is under the name Tan.",
      "start": "n1",
      "nodes": {
        "n1": {
          "speaker": "npc",
          "native": "いらっしゃいませ。チェックインですか。",
          "reading": "irasshaimase. chekkuin desu ka",
          "english": "Welcome. Checking in?",
          "speak": "いらっしゃいませ。チェックインですか。",
          "replies": [
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-chekkuin"
            },
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-yoyaku"
            },
            {
              "next": "n1b",
              "good": false,
              "phraseId": "p-gochisousama",
              "feedback": "That's said after a meal. Here, just say you're checking in."
            }
          ]
        },
        "n1b": {
          "speaker": "npc",
          "native": "チェックインでよろしいですか。",
          "reading": "chekkuin de yoroshii desu ka",
          "english": "Checking in, is that right?",
          "speak": "チェックインでよろしいですか。",
          "replies": [
            {
              "next": "n2",
              "good": true,
              "native": "はい、お願いします",
              "reading": "hai, onegai shimasu",
