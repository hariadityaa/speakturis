      "nodes": {
        "n1": {
          "speaker": "npc",
          "native": "いらっしゃいませ。お弁当、温めますか。",
          "reading": "irasshaimase. obentou, atatamemasu ka",
          "english": "Welcome. Shall I heat the bento?",
          "speak": "いらっしゃいませ。おべんとう、あたためますか。",
          "replies": [
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-atatamete"
            },
            {
              "next": "n2",
              "good": true,
              "native": "はい、お願いします",
              "reading": "hai, onegai shimasu",
              "english": "Yes, please",
              "speak": "はい、おねがいします"
            },
            {
              "next": "n1b",
              "good": false,
              "phraseId": "p-sumimasen",
              "feedback": "Polite, but it doesn't answer the question."
            }
          ]
        },
        "n1b": {
          "speaker": "npc",
          "native": "温めますか。",
          "reading": "atatamemasu ka",
          "english": "Heat it up?",
          "speak": "あたためますか。",
          "replies": [
            {
              "next": "n2",
              "good": true,
              "native": "はい、お願いします",
              "reading": "hai, onegai shimasu",
              "english": "Yes, please",
              "speak": "はい、おねがいします"
            },
            {
              "next": "n2",
