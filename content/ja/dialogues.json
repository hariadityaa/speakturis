              "english": "Card, please",
              "speak": "カードでおねがいします"
            },
            {
              "next": "n5",
              "good": true,
              "native": "現金でお願いします",
              "reading": "genkin de onegai shimasu",
              "english": "Cash, please",
              "speak": "げんきんでおねがいします"
            }
          ]
        },
        "n5": {
          "speaker": "npc",
          "native": "ありがとうございました。",
          "reading": "arigatou gozaimashita",
          "english": "Thank you very much.",
          "end": true
        }
