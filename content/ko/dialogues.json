          ]
        },
        "n3": {
          "speaker": "npc",
          "native": "탄 님이시군요. 체크아웃은 열한 시예요.",
          "reading": "tan nimisigunyo. chekeuauseun yeolhan siyeyo",
          "english": "Tan, yes. Check-out is at 11.",
          "replies": [
            {
              "next": "n4",
              "good": true,
