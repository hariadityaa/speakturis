    {
      "id": "d-hotel",
      "title": "Checking in at the hotel",
      "situation": "hotel",
      "intro": "You arrive at your hotel with your suitcase. Your booking is under the name Tan.",
      "start": "n1",
      "nodes": {
        "n1": {
          "speaker": "npc",
          "native": "어서 오세요. 체크인이세요?",
          "reading": "eoseo oseyo. chekeuiniseyo",
          "english": "Welcome. Checking in?",
          "replies": [
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-chekkuin"
            },
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-yoyaku"
            },
            {
              "next": "n1b",
              "good": false,
              "phraseId": "p-gochisousama",
              "feedback": "That's said after a meal. Here, just say you're checking in."
            }
          ]
        },
        "n1b": {
          "speaker": "npc",
          "native": "체크인 맞으세요?",
          "reading": "chekeuin majeuseyo",
          "english": "Checking in, is that right?",
          "replies": [
            {
              "next": "n2",
              "good": true,
              "native": "네, 부탁드려요",
              "reading": "ne, butakdeuryeoyo",
              "english": "Yes, please"
            },
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-chekkuin"
            }
          ]
        },
        "n2": {
          "speaker": "npc",
          "native": "예약하신 성함을 말씀해 주세요.",
          "reading": "yeyakasin seonghameul malsseumhae juseyo",
          "english": "The name on the reservation, please.",
          "replies": [
            {
              "next": "n3",
              "good": true,
              "native": "탄이에요",
              "reading": "tanieyo",
              "english": "It's Tan"
            },
            {
              "next": "n2b",
              "good": true,
              "phraseId": "p-wakarimasen"
            },
            {
              "next": "n2",
              "good": false,
              "phraseId": "p-yoyaku",
              "feedback": "They know you have one. They want the name. Listen for seongham."
