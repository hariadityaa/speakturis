          ]
        },
        "n2b": {
          "speaker": "npc",
          "native": "성함이요?",
          "reading": "seonghamiyo",
          "english": "Your name?",
          "replies": [
            {
              "next": "n3",
              "good": true,
              "native": "탄이에요",
              "reading": "tanieyo",
              "english": "It's Tan"
            },
            {
              "next": "n3",
              "good": true,
              "native": "죄송합니다, 탄이에요",
              "reading": "joesonghamnida, tanieyo",
              "english": "Sorry, it's Tan"
