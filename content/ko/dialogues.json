        },
        "n3": {
          "speaker": "npc",
          "native": "팔천오백 원이에요. 젓가락 드릴까요?",
          "reading": "palcheonobaek wonieyo. jeotgarak deurilkkayo",
          "english": "That's 8,500 won. Would you like chopsticks?",
          "replies": [
            {
              "next": "n4",
              "good": true,
              "phraseId": "p-hashi"
            },
            {
              "next": "n4",
              "good": true,
              "native": "젓가락은 필요 없어요",
              "reading": "jeotgarageun piryo eopseoyo",
              "english": "No chopsticks, thanks"
